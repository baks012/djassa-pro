# ──────────────────────────────────────────────────────
# DJASSA PRO — Variables d'environnement
# ──────────────────────────────────────────────────────
# Copier ce fichier en .env.local pour le développement local
# Sur Vercel, ajouter ces variables dans le dashboard (Settings → Environment Variables)

# ─── BASE DE DONNÉES ───────────────────────────────────
# Option A : SQLite local (développement sans serveur)
DATABASE_URL="file:./dev.db"

# Option B : PostgreSQL Neon (RECOMMANDÉ pour Vercel / Production)
# 1. Créer un compte gratuit sur https://neon.tech
# 2. Créer un projet → copier l'URL de connexion
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ─── SÉCURITÉ JWT ──────────────────────────────────────
# Générer une clé sécurisée (minimum 32 caractères aléatoires)
# Commande pour générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REMPLACEZ_PAR_UNE_CLE_SECRETE_LONGUE_ET_ALEATOIRE_MINIMUM_48_CHARS"

# ─── URL PUBLIQUE DE L'APPLICATION ─────────────────────
# En local : http://localhost:3000
# Sur Vercel : https://votre-projet.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── ENVIRONNEMENT ─────────────────────────────────────
NODE_ENV="development"
